# Salin jadi .env.local (JANGAN di-commit). Di Vercel isi lewat Settings -> Environment Variables.
# RPC untuk server (Alchemy/Infura untuk Amoy). Untuk uji lokal: http://127.0.0.1:8545
RPC_URL_SERVER=http://127.0.0.1:8545
# String acak >= 32 karakter: openssl rand -hex 32
AUTH_SECRET=
# Pinata. Kalau PINATA_JWT kosong, berkas disimpan di folder .ipfs-lokal (hanya untuk uji di laptop)
PINATA_JWT=
NEXT_PUBLIC_GATEWAY_URL=
