# Salin ke .env.local lalu isi. File .env.local tidak pernah di-commit.

# Neon: string koneksi pooled (dipakai API) dan langsung (dipakai migrasi)
DATABASE_URL=
DATABASE_URL_LANGSUNG=

# Privy: Dashboard → Configuration → App settings
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PEM kunci verifikasi; tulis dalam satu baris dengan \n sebagai pemisah baris
PRIVY_VERIFICATION_KEY=

# Pinata: API key (JWT) dengan izin upload
PINATA_JWT=
PUBLIC_GATEWAY_URL=

# Buat dengan: openssl rand -hex 32
KUNCI_MASTER=

# Rantai: Anvil (lokal) atau Polygon Amoy
RPC_URL=http://127.0.0.1:8545
PUBLIC_RPC_URL=http://127.0.0.1:8545
ALAMAT_KONTRAK=0x5FbDB2315678afecb367f032d93F642f64180aa3
CHAIN_ID=31337
